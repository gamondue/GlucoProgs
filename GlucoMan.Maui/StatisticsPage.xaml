<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:GlucoMan.Maui.Resources.Strings"
             x:Class="GlucoMan.Maui.StatisticsPage"
             Title="{x:Static res:AppStrings.StatisticsPageTitle}">
    <ScrollView Padding="10,10,10,10">
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding DateRange}" 
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="Black"/>

            <BoxView HeightRequest="2" 
                     Color="#f39c12" 
                     Margin="0,5,0,5"/>

            <!-- ==================== INSULIN SECTION (Light Yellow Background) ==================== -->
            <!-- Breakfast Insulin -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#f39c12"
                   BackgroundColor="#fef9e7"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatBreakfastInsulin}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#b7950b"/>
                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6" RowDefinitions="Auto,0,Auto,Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static res:AppStrings.StatHeaderAllDays}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="{x:Static res:AppStrings.StatHeaderEffective}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinBreakfast.Mean}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{Binding InsulinBreakfastEff.Mean}" Grid.Row="2" Grid.Column="2" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinBreakfast.StdDev}" Grid.Row="3" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{Binding InsulinBreakfastEff.StdDev}" Grid.Row="3" Grid.Column="2" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="4" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinBreakfast.Samples}" Grid.Row="4" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                        <Label Text="{Binding InsulinBreakfastEff.Samples}" Grid.Row="4" Grid.Column="2" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Lunch Insulin -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#f39c12"
                   BackgroundColor="#fef9e7"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatLunchInsulin}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#b7950b"/>
                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6" RowDefinitions="Auto,0,Auto,Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static res:AppStrings.StatHeaderAllDays}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="{x:Static res:AppStrings.StatHeaderEffective}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinLunch.Mean}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{Binding InsulinLunchEff.Mean}" Grid.Row="2" Grid.Column="2" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinLunch.StdDev}" Grid.Row="3" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{Binding InsulinLunchEff.StdDev}" Grid.Row="3" Grid.Column="2" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="4" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinLunch.Samples}" Grid.Row="4" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                        <Label Text="{Binding InsulinLunchEff.Samples}" Grid.Row="4" Grid.Column="2" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Dinner Insulin -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#f39c12"
                   BackgroundColor="#fef9e7"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatDinnerInsulin}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#b7950b"/>
                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6" RowDefinitions="Auto,0,Auto,Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static res:AppStrings.StatHeaderAllDays}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="{x:Static res:AppStrings.StatHeaderEffective}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinDinner.Mean}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{Binding InsulinDinnerEff.Mean}" Grid.Row="2" Grid.Column="2" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinDinner.StdDev}" Grid.Row="3" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{Binding InsulinDinnerEff.StdDev}" Grid.Row="3" Grid.Column="2" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="4" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinDinner.Samples}" Grid.Row="4" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                        <Label Text="{Binding InsulinDinnerEff.Samples}" Grid.Row="4" Grid.Column="2" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Other Insulin -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#f39c12"
                   BackgroundColor="#fef9e7"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatOtherInsulin}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#b7950b"/>
                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6" RowDefinitions="Auto,0,Auto,Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static res:AppStrings.StatHeaderAllDays}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="{x:Static res:AppStrings.StatHeaderEffective}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinOther.Mean}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{Binding InsulinOtherEff.Mean}" Grid.Row="2" Grid.Column="2" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinOther.StdDev}" Grid.Row="3" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{Binding InsulinOtherEff.StdDev}" Grid.Row="3" Grid.Column="2" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="4" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinOther.Samples}" Grid.Row="4" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                        <Label Text="{Binding InsulinOtherEff.Samples}" Grid.Row="4" Grid.Column="2" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Total Day Dose (TDD) -->
            <Frame Padding="12"
                   CornerRadius="8"
                   BorderColor="#f39c12"
                   BackgroundColor="#fef9e7"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatTotalDayDose}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#b7950b"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinTdd.Mean}" Grid.Row="0" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinTdd.StdDev}" Grid.Row="1" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.Days}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinTdd.Samples}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Total Quick Acting Insulin -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#f39c12"
                   BackgroundColor="#fef9e7"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatTotalQuickActingInsulin}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#b7950b"/>
                    <Label Text="{x:Static res:AppStrings.StatRapidPlusShort}"
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextColor="Gray"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Text="{x:Static res:AppStrings.StatUiPerDay}" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" TextColor="#000000"/>
                        <Label Text="{Binding InsulinQuick.PerDayMean}" Grid.Row="0" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinQuick.Mean}" Grid.Row="1" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinQuick.StdDev}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinQuick.Samples}" Grid.Row="3" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Total Long Acting Insulin -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#f39c12"
                   BackgroundColor="#fef9e7"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatTotalLongActingInsulin}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#b7950b"/>
                    <Label Text="{x:Static res:AppStrings.StatIntermediatePlusLong}"
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextColor="Gray"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Text="{x:Static res:AppStrings.StatUiPerDay}" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" TextColor="#000000"/>
                        <Label Text="{Binding InsulinLong.PerDayMean}" Grid.Row="0" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinLong.Mean}" Grid.Row="1" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinLong.StdDev}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding InsulinLong.Samples}" Grid.Row="3" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="2" 
                     Color="#e74c3c" 
                     Margin="0,10,0,10"/>
            <!-- ==================== GLUCOSE SECTION (Light Red Background) ==================== -->
            
            <!-- Blood Glucose -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#e74c3c"
                   BackgroundColor="#fdecea"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatBloodGlucose}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#c0392b"/>
                    <Label Text="{Binding GlucoseDataSource}"
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextColor="{Binding GlucoseDataSourceColor}"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseTotal.Mean}" Grid.Row="0" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseTotal.StdDev}" Grid.Row="1" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseTotal.Samples}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Morning Glucose -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#e74c3c"
                   BackgroundColor="#fdecea"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatMorningGlucose}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#c0392b"/>
                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static res:AppStrings.StatHeaderAllDays}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="{x:Static res:AppStrings.StatHeaderEffective}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseBreakfast.Mean}" Grid.Row="1" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{Binding GlucoseBreakfastEff.Mean}" Grid.Row="1" Grid.Column="2" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseBreakfast.StdDev}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{Binding GlucoseBreakfastEff.StdDev}" Grid.Row="2" Grid.Column="2" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseBreakfast.Samples}" Grid.Row="3" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                        <Label Text="{Binding GlucoseBreakfastEff.Samples}" Grid.Row="3" Grid.Column="2" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Midday Glucose -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#e74c3c"
                   BackgroundColor="#fdecea"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatMiddayGlucose}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#c0392b"/>
                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static res:AppStrings.StatHeaderAllDays}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="{x:Static res:AppStrings.StatHeaderEffective}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseLunch.Mean}" Grid.Row="1" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{Binding GlucoseLunchEff.Mean}" Grid.Row="1" Grid.Column="2" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseLunch.StdDev}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{Binding GlucoseLunchEff.StdDev}" Grid.Row="2" Grid.Column="2" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseLunch.Samples}" Grid.Row="3" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                        <Label Text="{Binding GlucoseLunchEff.Samples}" Grid.Row="3" Grid.Column="2" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Evening Glucose -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#e74c3c"
                   BackgroundColor="#fdecea"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatEveningGlucose}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#c0392b"/>
                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static res:AppStrings.StatHeaderAllDays}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="{x:Static res:AppStrings.StatHeaderEffective}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseDinner.Mean}" Grid.Row="1" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{Binding GlucoseDinnerEff.Mean}" Grid.Row="1" Grid.Column="2" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseDinner.StdDev}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{Binding GlucoseDinnerEff.StdDev}" Grid.Row="2" Grid.Column="2" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseDinner.Samples}" Grid.Row="3" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                        <Label Text="{Binding GlucoseDinnerEff.Samples}" Grid.Row="3" Grid.Column="2" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Night Glucose -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#e74c3c"
                   BackgroundColor="#fdecea"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatNightGlucose}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#c0392b"/>
                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static res:AppStrings.StatHeaderAllDays}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="{x:Static res:AppStrings.StatHeaderEffective}" HorizontalOptions="End" FontSize="11" TextColor="Gray" FontAttributes="Italic"/>
                        <Label Text="{x:Static res:AppStrings.StatMean}" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseOther.Mean}" Grid.Row="1" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{Binding GlucoseOtherEff.Mean}" Grid.Row="1" Grid.Column="2" HorizontalOptions="End" TextColor="#27ae60"/>
                        <Label Text="{x:Static res:AppStrings.StatStdDev}" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseOther.StdDev}" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{Binding GlucoseOtherEff.StdDev}" Grid.Row="2" Grid.Column="2" HorizontalOptions="End" TextColor="#c0392b"/>
                        <Label Text="{x:Static res:AppStrings.StatSamples}" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" TextColor="#34495e"/>
                        <Label Text="{Binding GlucoseOther.Samples}" Grid.Row="3" Grid.Column="1" HorizontalOptions="End" TextColor="#8e44ad"/>
                        <Label Text="{Binding GlucoseOtherEff.Samples}" Grid.Row="3" Grid.Column="2" HorizontalOptions="End" TextColor="#8e44ad"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="2" 
                     Color="#3498db" 
                     Margin="0,10,0,10"/>

            <!-- ==================== CHO SECTION (Light Blue Background) ==================== -->

            <!-- Total Day CHO -->
            <Frame Padding="12" 
                   CornerRadius="8"
                   BorderColor="#3498db"
                   BackgroundColor="#ebf5fb"
                   HasShadow="True"
                   Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static res:AppStrings.StatTotalDayCHO}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#2980b9"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Text="{x:Static res:AppStrings.StatChoPerDay}" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" TextColor="#000000"/>
                        <Label Text="{Binding ChoTotal.PerDayMean}" Grid.Row="0" Grid.Column="1" HorizontalOptions="End" TextColor="#27ae60"/>
