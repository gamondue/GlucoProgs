<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:GlucoMan.Maui.Resources.Strings"
             x:Class="GlucoMan.Maui.AlarmPage"
             Title="{x:Static strings:AppStrings.AlarmPageTitle}">
    <ContentPage.Resources>
        <!-- Colors / Brushes reused across fields -->
        <Color x:Key="EditBackColor">LightGreen</Color>
        <Color x:Key="ResultBackColor">#ADD8E6</Color> <!-- Light Azure -->
        <Style x:Key="EditEntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{StaticResource EditBackColor}" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style x:Key="ResultEntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{StaticResource ResultBackColor}" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="2,4,2,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,350">
        <ScrollView Grid.Row="0" VerticalOptions="FillAndExpand">
            <VerticalStackLayout Padding="6" Spacing="4">
            
            <!-- Windows-specific warning banner -->
            <Frame x:Name="frmWindowsWarning" 
                   IsVisible="False"
                   BackgroundColor="#FFF3CD" 
                   BorderColor="#FFC107" 
                   CornerRadius="6" 
                   Padding="12" 
                   Margin="0,0,0,8">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="lblWindowsWarningTitle"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#856404" />
                    <Label x:Name="lblWindowsWarningMessage"
                           TextColor="#856404" FontSize="13" />
                    <Label x:Name="lblWindowsWarningTip"
                           FontSize="12"
                           FontAttributes="Italic"
                           TextColor="#856404" />
                </VerticalStackLayout>
            </Frame>
            
            <!-- Current Alarm Editing Panel -->
            <Frame BorderColor="#888" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,70,*,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <!-- Row 0: Id / Reminder -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="4" ColumnDefinitions="20, 45, Auto, *">
                        <Label Grid.Column="0" VerticalOptions="Center" Text="{x:Static strings:AppStrings.Id}" />
                        <Entry Grid.Column="1" VerticalOptions="Center" x:Name="txtIdAlarm" 
                               Style="{StaticResource ResultEntryStyle}" 
                               SemanticProperties.Hint="{x:Static strings:AppStrings.TooltipAlarmId}" />
                        <Label Grid.Column="2" VerticalOptions="Center" Text="{x:Static strings:AppStrings.Reminder}" />
                        <Entry Grid.Column="3" VerticalOptions="Center" x:Name="txtReminderText"
                               Style="{StaticResource EditEntryStyle}" 
                               Placeholder="Reminder text" 
                               SemanticProperties.Hint="{x:Static strings:AppStrings.TooltipReminderText}" />
                    </Grid>
                    <!-- Row 1: TimeStart Date/Time -->
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                        <Label Text="{x:Static strings:AppStrings.StartDate}" WidthRequest="60" />
                        <DatePicker x:Name="dtpStartDate" BackgroundColor="{StaticResource EditBackColor}" 
                                    ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipStartDate}" />
                    </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">
                        <Label WidthRequest="60" Text="{x:Static strings:AppStrings.StartTime}" />
                        <TimePicker x:Name="tpStartTime" BackgroundColor="{StaticResource EditBackColor}" 
                                    ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipStartTime}" />
                        <Button ImageSource="clock.png"
                                x:Name="btnNowStart"
                                HeightRequest="40"
                                Margin="2" 
                                ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipNowButton}"
                                Clicked="BtnNowStart_Click"/>
                    </HorizontalStackLayout>
                        <!-- Alarm Period: periodic repetition interval, in minutes -->
                        <Label Grid.Row="2" Grid.Column="0" Text="{x:Static strings:AppStrings.AlarmPeriod}" />
                    <Entry x:Name="txtInterval" Grid.Row="2" Grid.Column="1" Style="{StaticResource EditEntryStyle}" Keyboard="Numeric"
                           ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipAlarmPeriod}" />

                    <!-- Startup grace window: fire passed alarms at program startup if within this delay -->
                    <Label Grid.Row="2" Grid.Column="2" Text="{x:Static strings:AppStrings.TriggerAfterTime}" />
                    <Entry x:Name="txtStartupGrace" Grid.Row="2" Grid.Column="3"
                           Style="{StaticResource EditEntryStyle}" Keyboard="Numeric"
                           ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipTriggerAfter}" />

                    <!-- Row 3: Sound flags -->
                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                        ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto"
                        ColumnSpacing="0"
                        VerticalOptions="Center">
                        <Grid Grid.Column="0" ColumnDefinitions="35,*">
                            <CheckBox x:Name="chkPlaySound" Grid.Row="0" Grid.Column="0" Margin="0"
                            ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipPlaySound}" />
                            <Label Grid.Row="0" Grid.Column="1"
                                VerticalOptions="Center"
                                Text="{x:Static strings:AppStrings.PlaySound}" />
                        </Grid>
                        <Grid Grid.Column="1" ColumnDefinitions="35,*">
                            <CheckBox x:Name="chkVibrate" Grid.Row="0" Grid.Column="0" Margin="0"
                                ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipVibrate}" />
                            <Label Grid.Row="0" Grid.Column="1"
                                VerticalOptions="Center"
                                Text="{x:Static strings:AppStrings.Vibrate}" />
                        </Grid>
                        <Grid Grid.Column="2" ColumnDefinitions="35,*">
                             <CheckBox x:Name="chkAlarmActive"
                                  ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipActiveAlarm}"
                                  Margin="4,0" />
                             <Label Grid.Column="1"
                                    Text="{x:Static strings:AppStrings.Active}"
                                    VerticalOptions="Center"
                           Margin="0,0,12,0" />
                        </Grid>
                    </Grid>
                    
                    <!-- Row 4: Duration / RepetitionTime -->
                    <Label Grid.Row="4" Grid.Column="0" Text="{x:Static strings:AppStrings.AlarmDuration}" />
                    <Entry x:Name="txtDuration" Grid.Row="4" Grid.Column="1" Style="{StaticResource EditEntryStyle}" Keyboard="Numeric" 
                           ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipAlarmDuration}" />

                    <Label Grid.Row="4" Grid.Column="2" Text="{x:Static strings:AppStrings.RepetitionAfter}" />
                    <Entry x:Name="txtRepetitionTime" Grid.Row="4" Grid.Column="3" Style="{StaticResource EditEntryStyle}" Keyboard="Numeric" 
                           ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipRepetitionTime}" />

                    <!-- Row 5: Repeat Count / Max -->
                    <Label Grid.Row="5" Grid.Column="0" Text="{x:Static strings:AppStrings.MaxRepeats}" />
                    <Entry x:Name="txtMaxRestarts" Grid.Row="5" Grid.Column="1" Style="{StaticResource EditEntryStyle}" Keyboard="Numeric" 
                        ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipMaxRepeats}" />

                        <Label Grid.Row="5" Grid.Column="2" Text="{x:Static strings:AppStrings.RestartCount}" />
                    <Entry x:Name="txtRestartsCount" Grid.Row="5" Grid.Column="3" Style="{StaticResource ResultEntryStyle}" 
                           ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipRestartCount}" />

                    <!-- Row 6: Next / Last trigger -->
                   <VerticalStackLayout Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
                        <Label WidthRequest="90" 
                            Text="{x:Static strings:AppStrings.NextTrigger}" />
                        <Entry x:Name="txtNextTriggerTime" Style="{StaticResource ResultEntryStyle}" 
                           ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipNextTrigger}" />
                   </VerticalStackLayout>

                   <VerticalStackLayout Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2">
                        <Label WidthRequest="90"
                            Text="{x:Static strings:AppStrings.LastTrigger}" />
                        <Entry x:Name="txtLastTriggerTime" Style="{StaticResource ResultEntryStyle}" 
                           ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipLastTrigger}" />
                   </VerticalStackLayout>

                        <!-- Row 7: Triggered Count / Playing -->
                    <Label Grid.Row="7" Grid.Column="0" Text="{x:Static strings:AppStrings.Triggered}" />
                    <Entry x:Name="txtTriggeredCount" Grid.Row="7" Grid.Column="1" Style="{StaticResource ResultEntryStyle}" 
                           ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipTriggeredCount}" />
                    <Grid Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="2"
                        ColumnDefinitions="Auto,Auto" RowDefinitions="Auto"
                        ColumnSpacing="0"
                        VerticalOptions="Center">
                        <Grid ColumnDefinitions="35,*">
                            <CheckBox x:Name="chkPlaying" Grid.Row="0" Grid.Column="0" Margin="0"
                                ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipPlaying}" />
                            <Label Grid.Row="0" Grid.Column="1"
                            VerticalOptions="Center"
                            Text="{x:Static strings:AppStrings.Playing}" />
                        </Grid>
                    </Grid>

                    <!-- Row 8: Sound file path -->
                    <Label Grid.Row="8" Grid.Column="0" Text="{x:Static strings:AppStrings.Sound}" />
                    <Entry x:Name="txtSoundFilePath" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource EditEntryStyle}" 
                           Placeholder="{x:Static strings:AppStrings.PathOrFilename}" 
                           ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipSoundFilePath}" />

                    <!-- Row 9: State -->
                    <HorizontalStackLayout Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4">
                        <Label WidthRequest="40"
                            Text="{x:Static strings:AppStrings.Status}" />
                        <Entry x:Name="txtState" Style="{StaticResource ResultEntryStyle}"
                            ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipAlarmState}" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <!-- Command Buttons -->
            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" 
                        JustifyContent="Start">
            <Button x:Name="btnSaveAlarm" 
                    ImageSource="floppy_disc.png"
                    Margin="2"
                    HeightRequest="50"
                    BackgroundColor="LightCoral"
                    ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipSaveAlarm}" />

            <Button x:Name="btnAddAlarm" 
                    ImageSource="plus.png"
                    Margin="2"
                    HeightRequest="50"
                    BackgroundColor="{StaticResource Primary}"
                    ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipAddAlarm}" />
            <Button x:Name="btnDeleteAlarm" 
                    ImageSource="minus.png"
                    Margin="2"
                    HeightRequest="50"
                    BackgroundColor="LightCoral"
                    ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipDeleteAlarm}" />
            <Button x:Name="btnClearAlarm" 
                    ImageSource="details.png"
                    Margin="2"
                    HeightRequest="50"
                    BackgroundColor="{StaticResource Primary}"
                    ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipClearAlarmFields}" />
            <Button x:Name="btnDismiss" 
                    Text="{x:Static strings:AppStrings.Dismiss}"
                    Margin="2"
                    HeightRequest="50"
                    BackgroundColor="{StaticResource Primary}"
                    ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipDismissAlarm}" />
            <Button x:Name="btnTest" 
                    Text="{x:Static strings:AppStrings.Test}"
                    Margin="2"
                    HeightRequest="50"
                    BackgroundColor="{StaticResource Primary}"
                    ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipTestAlarm}" />
            <Button x:Name="btnSetNext" 
                    Text="{x:Static strings:AppStrings.SetNext}" 
                    Margin="2"
                    HeightRequest="50"
                    BackgroundColor="{StaticResource Primary}"
                    ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipSetNextTrigger}" />
            </FlexLayout>

            <!-- Filters Panel -->
            <Frame BorderColor="#888" CornerRadius="6" Padding="6" Margin="0,3,0,2">
                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
                    <Label Text="{x:Static strings:AppStrings.From}" Margin="4,0" />
                    <DatePicker x:Name="dtpFrom" BackgroundColor="{StaticResource EditBackColor}" 
                                Margin="0,0,12,0"
                                ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipFilterFromDate}" />
                    <Label Text="{x:Static strings:AppStrings.To}" Margin="4,0" />
                    <DatePicker x:Name="dtpTo" BackgroundColor="{StaticResource EditBackColor}" 
                                Margin="0,0,12,0"
                                ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipFilterToDate}" />
                    <RadioButton x:Name="chkShowAll"
                                 Content="{x:Static strings:AppStrings.AllAlarms}"
                                 Margin="0,0,8,0"
                                 VerticalOptions="Center"
                                 ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipShowAllAlarms}" />
                    <RadioButton x:Name="chkActive" IsChecked="True"
                                 Content="{x:Static strings:AppStrings.ActiveAlarms}"
                                 Margin="0,0,8,0"
                                 VerticalOptions="Center"
                                 ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipShowActiveAlarms}" />
                    <RadioButton x:Name="chkExpired"
                                 Content="{x:Static strings:AppStrings.ExpiredAlarms}"
                                 Margin="0,0,12,0"
                                 VerticalOptions="Center"
                                 ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipShowExpiredAlarms}" />
                    <RadioButton x:Name="chkWaiting"
                                 Content="{x:Static strings:AppStrings.WaitingAlarms}"
                                 Margin="0,0,8,0"
                                 VerticalOptions="Center"
                                 ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipShowWaitingAlarms}" />
                    <RadioButton x:Name="chkDelayed"
                                 Content="{x:Static strings:AppStrings.DelayedAlarms}"
                                 Margin="0,0,8,0"
                                 VerticalOptions="Center"
                                 ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipShowDelayedAlarms}" />
                    <RadioButton x:Name="chkAutoSuspended"
                                 Content="{x:Static strings:AppStrings.AutoSuspendedAlarms}"
                                 Margin="0,0,12,0"
                                 VerticalOptions="Center"
                                 ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipShowAutoSuspendedAlarms}" />
                    <Button x:Name="btnRefresh"
                            Margin="4" BackgroundColor="{StaticResource Primary}"
                            Text="{x:Static strings:AppStrings.Refresh}"
                            ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipRefreshAlarms}" />
                    <Button x:Name="btnNow" Text="{x:Static strings:AppStrings.Now}" 
                            Margin="4" BackgroundColor="{StaticResource Primary}"
                            ToolTipProperties.Text="{x:Static strings:AppStrings.TooltipNowAlarm}" />
                    </FlexLayout>
            </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom: list area so CollectionView owns scrolling/touches -->
        <Grid Grid.Row="1" Padding="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <HorizontalStackLayout Grid.Row="0" Spacing="10">
                <Label Text="{x:Static strings:AppStrings.AlarmsList}" FontAttributes="Bold" />
                <Label x:Name="lblAlarmCount" Text="{x:Static strings:AppStrings.NoAlarmsCount}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <!-- Fixed column header for the alarms list (does not scroll) -->
            <Grid Grid.Row="1" ColumnDefinitions="20*,40*,80*,80*,20*" ColumnSpacing="4" BackgroundColor="#ececec" Margin="0,6,0,0" Padding="4,6">
                <Label Text="{x:Static strings:AppStrings.Id}" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Label Grid.Column="1" Text="{x:Static strings:AppStrings.Reminder}" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                <Label Grid.Column="2" Text="{x:Static strings:AppStrings.Start}" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Label Grid.Column="3" Text="{x:Static strings:AppStrings.Next}" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Label Grid.Column="4" Text="{x:Static strings:AppStrings.ActivationCount}" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Grid>
            <CollectionView Grid.Row="2" x:Name="cvAlarms" SelectionMode="Single" BackgroundColor="LightGray" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                <Frame CornerRadius="6" Padding="6" Margin="2,1" BackgroundColor="White" BorderColor="#DDD" HasShadow="True" HorizontalOptions="FillAndExpand">
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsSelectedInList}" Value="True">
                                    <Setter Property="BorderColor" Value="DeepSkyBlue" />
                                    <Setter Property="BackgroundColor" Value="#e6f7ff" />
                                </DataTrigger>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsSelectedInList}" Value="False">
                                    <Setter Property="BorderColor" Value="#DDD" />
                                    <Setter Property="BackgroundColor" Value="White" />
                                </DataTrigger>
                            </Frame.Triggers>
                            <Grid ColumnDefinitions="20*,40*,80*,80*,20*" ColumnSpacing="4">
                                <Label Text="{Binding IdAlarm}" TextColor="Black" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" FontSize="14" />
                                <Label Grid.Column="1" Text="{Binding ReminderText, TargetNullValue={x:Static strings:AppStrings.NoReminder}}"
                                       TextColor="Black" LineBreakMode="TailTruncation" 
                                       VerticalTextAlignment="Center" 
                                       FontSize="14" HorizontalOptions="StartAndExpand" MaxLines="2" />
                                <Label Grid.Column="2" Text="{Binding TimeStart.DateTime}" TextColor="Black" 
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="3" Text="{Binding NextTriggerTime}" TextColor="Black" 
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="4" Text="{Binding TriggeredCount}" TextColor="Black" 
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" FontSize="14" />
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="{x:Static strings:AppStrings.NoAlarmsDisplay}" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
