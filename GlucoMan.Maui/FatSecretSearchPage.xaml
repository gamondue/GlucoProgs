<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GlucoMan.Maui.FatSecretSearchPage"
             Title="FatSecret Search">
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="10">

            <!-- Search Section -->
            <VerticalStackLayout Grid.Row="0" Spacing="5">
                <Label Text="Search Food in FatSecret" 
                       FontSize="16" FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>

                <!-- Search by name -->
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Grid.Column="0" x:Name="txtSearchQuery" 
                           Placeholder="Enter food name..." 
                           HorizontalOptions="FillAndExpand"
                           BackgroundColor="White" TextColor="Black"
                           Completed="txtSearchQuery_Completed"/>
                    <Button Grid.Column="1" x:Name="btnSearch"
                            Text="🔍" WidthRequest="50"
                            ToolTipProperties.Text="Search FatSecret by text"
                            Clicked="btnSearch_Clicked"/>
                </Grid>

                <!-- Search by barcode -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Entry Grid.Column="0" x:Name="txtBarcode"
                           Placeholder="Barcode (EAN-13 / UPC)..."
                           Keyboard="Text"
                           BackgroundColor="White" TextColor="Black"
                           Completed="txtBarcode_Completed"/>
                    <Button Grid.Column="1" x:Name="btnScanBarcode"
                            Text="📷"
                            WidthRequest="50"
                            ToolTipProperties.Text="Scan barcode with camera"
                            Clicked="btnScanBarcode_Clicked"/>
                    <Button Grid.Column="2" x:Name="btnSearchBarcode"
                            Text="🔍"
                            WidthRequest="50"
                            ToolTipProperties.Text="Search FatSecret by barcode"
                            Clicked="btnSearchBarcode_Clicked"/>
                </Grid>

                <Label x:Name="lblStatus" Text="" 
                       FontSize="12" TextColor="Gray"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Auth Section -->
            <VerticalStackLayout Grid.Row="1" Spacing="5" Margin="0,5,0,5">
                <!-- Login status and buttons -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" x:Name="lblAuthStatus"
                           Text="Not logged in"
                           FontSize="12" TextColor="Gray"
                           VerticalTextAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="btnLogin"
                            Text="Login with FatSecret"
                            Clicked="btnLogin_Clicked"/>
                    <Button Grid.Column="2" x:Name="btnShowCredentials"
                            Text="Keys"
                            FontSize="12"
                            Clicked="btnShowCredentials_Clicked"/>
                </Grid>

                <!-- Credentials Section (hidden by default) -->
                <Frame x:Name="frameCredentials"
                       IsVisible="False"
                       BackgroundColor="LightYellow" BorderColor="Orange"
                       Padding="10" Margin="0,5,0,0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="FatSecret API Credentials"
                               FontAttributes="Bold" TextColor="DarkOrange"/>
                        <Label Text="Register for free at platform.fatsecret.com"
                               FontSize="12"/>
                        <Entry x:Name="txtClientId"
                               Placeholder="Consumer Key (= Client ID)"
                               BackgroundColor="White" TextColor="Black"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0" x:Name="txtClientSecret"
                                   Placeholder="Client Secret (OAuth 2.0)"
                                   IsPassword="True"
                                   BackgroundColor="White" TextColor="Black"/>
                            <Button Grid.Column="1" x:Name="btnToggleClientSecret"
                                    Text="Show" FontSize="11" WidthRequest="60"
                                    Clicked="btnToggleSecret_Clicked"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0" x:Name="txtConsumerSecret"
                                   Placeholder="Consumer Secret (OAuth 1.0 - for Login)"
                                   IsPassword="True"
                                   BackgroundColor="White" TextColor="Black"/>
                            <Button Grid.Column="1" x:Name="btnToggleConsumerSecret"
                                    Text="Show" FontSize="11" WidthRequest="60"
                                    Clicked="btnToggleSecret_Clicked"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                            <Entry Grid.Column="0" x:Name="txtLanguage"
                                   Placeholder="Language (es: it, en, de)"
                                   Text="it"
                                   BackgroundColor="White" TextColor="Black"/>
                            <Entry Grid.Column="1" x:Name="txtRegion"
                                   Placeholder="Region (es: IT, US, DE)"
                                   Text="IT"
                                   BackgroundColor="White" TextColor="Black"/>
                        </Grid>
                        <Label Text="Language/Region: it/IT = Italy, en/US = USA, de/DE = Germany, fr/FR = France..."
                               FontSize="11" TextColor="Gray"/>
                        <Button x:Name="btnSaveCredentials" Text="Save Credentials"
                                Clicked="btnSaveCredentials_Clicked"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Results List -->
            <CollectionView x:Name="listResults" Grid.Row="2"
                            SelectionMode="Single"
                            SelectionChanged="listResults_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,5,0,5"
                                BackgroundColor="White"
                                StrokeThickness="1" Stroke="LightGray">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="3" InputTransparent="True">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold" FontSize="14"
                                       TextColor="Black" InputTransparent="True"/>
                                <Label Text="{Binding BrandName}"
                                       FontSize="12" TextColor="Gray" InputTransparent="True"/>
                                <Label Text="{Binding Description}"
                                       FontSize="11" TextColor="DarkGray"
                                       LineBreakMode="WordWrap" InputTransparent="True"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Buttons -->
            <HorizontalStackLayout Grid.Row="3" 
                                   HorizontalOptions="Center" Spacing="20"
                                   Margin="0,10,0,10">
                <Button x:Name="btnSelect" Text="Select Food" 
                        IsEnabled="False"
                        BackgroundColor="Green" TextColor="White"
                        Clicked="btnSelect_Clicked"/>
                <Button x:Name="btnCancel" Text="Cancel" 
                        Clicked="btnCancel_Clicked"/>
            </HorizontalStackLayout>

                <!-- FatSecret Branding -->
                <Image Grid.Row="4"
                       Source="fatsecret_powered.png"
                       HorizontalOptions="Center"
                       Margin="0,6,0,4"/>

            </Grid>
        </ScrollView>
</ContentPage>