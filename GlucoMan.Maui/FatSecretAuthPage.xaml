<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GlucoMan.Maui.FatSecretAuthPage"
             Title="FatSecret Login">
    <Grid RowDefinitions="Auto,*,Auto" Padding="10">

        <Label Grid.Row="0" x:Name="lblStatus"
               Text="Loading FatSecret authorization..."
               FontSize="14" HorizontalTextAlignment="Center"
               Margin="0,5"/>

        <WebView Grid.Row="1" x:Name="webViewAuth"
                 VerticalOptions="FillAndExpand"
                 HorizontalOptions="FillAndExpand"
                 Navigating="webViewAuth_Navigating"/>

        <Button Grid.Row="2" x:Name="btnCancel"
                Text="Cancel"
                Clicked="btnCancel_Clicked"
                Margin="0,10,0,5"/>
    </Grid>
</ContentPage>
