<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="GlucoMan.Maui.BarcodeScannerPage"
             Title="Barcode Scanner">
    <ContentPage.Content>
        <Grid RowDefinitions="*,Auto,Auto,Auto,Auto">
            <Frame Grid.Row="0" 
                   Padding="15" 
                   CornerRadius="0"
                   HasShadow="False"
                   BorderColor="Transparent">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCameraFrameTapped"/>
                </Frame.GestureRecognizers>
                <Grid>
                    <zxing:CameraBarcodeReaderView 
                        x:Name="cameraBarcodeReaderView"
                        IsDetecting="True"
                        BarcodesDetected="CameraBarcodeReaderView_BarcodesDetected" />
                    <Label x:Name="lblTapToFocus"
                           Text="Tap to focus"
                           FontSize="Small"
                           TextColor="White"
                           BackgroundColor="#55000000"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="End"
                           Margin="0,0,0,4"
                           Opacity="0.7"/>
                </Grid>
            </Frame>

            <Label Grid.Row="1" x:Name="lblScannedCode" 
                   Text="" 
                   FontSize="Medium" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" 
                   VerticalTextAlignment="Center"
                   Margin="10,5,10,0"/>

            <HorizontalStackLayout Grid.Row="2" 
                                   HorizontalOptions="Center" 
                                   Margin="10,5,10,5">
                <Button x:Name="btnPickPhoto"
                        Text="📷"
                        ToolTipProperties.Text="Pick a barcode photo from the filesystem"
                        Clicked="btnPickPhoto_Clicked"
                        Margin="0,0,5,0"
                        WidthRequest="50"/>
                <Label x:Name="lblPickPhotoResult" 
                       Text="Pick a barcode photo from file"
                       VerticalTextAlignment="Center"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Row="3" 
                                   HorizontalOptions="Center" 
                                   Margin="10,5,10,5">
                <Label Text="Manual entry:" 
                       VerticalTextAlignment="Center" Margin="0,0,5,0"/>
                <Entry x:Name="txtManualBarcode" 
                       WidthRequest="200"
                       Keyboard="Text"
                       Placeholder="Enter barcode"
                       HorizontalTextAlignment="Center"/>
            </HorizontalStackLayout>

            <Grid Grid.Row="4" ColumnDefinitions="*,*"
                  Margin="10,5,10,10">
                <Button Grid.Column="0" x:Name="btnConfirm" 
                        Text="OK"
                        HeightRequest="50"
                        Clicked="btnConfirm_Clicked"
                        Margin="5"/>
                <Button Grid.Column="1" x:Name="btnEscape"
                        ImageSource="escape.png"
                        HeightRequest="50"
                        ToolTipProperties.Text="Escape: closes the page without returning a barcode"
                        HorizontalOptions="Fill"
                        Clicked="btnEscape_Clicked"
                        Margin="5"/>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
