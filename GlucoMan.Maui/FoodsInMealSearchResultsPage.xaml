<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:GlucoMan.Maui.Converters"
             xmlns:strings="clr-namespace:GlucoMan.Maui.Resources.Strings"
             x:Class="GlucoMan.Maui.FoodsInMealSearchResultsPage"
             Title="{x:Static strings:AppStrings.FoodsInMealSearchResults}" 
             Loaded="PageLoad">
    <ContentPage.Resources>
     <ResourceDictionary>
    <converters:DoubleTextConverter x:Key="DoubleTextConverter" />
  </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid Grid.RowDefinitions="Auto
              ,Auto,Auto,65,Auto,*"
            Grid.ColumnDefinitions="*, *, *, *">
            <Label Grid.Row="0" Grid.Column="0" TextColor="Black" 
                Grid.ColumnSpan="4" Text="{x:Static strings:AppStrings.SearchOfFoodsInMealsPageTitle}" 
                    HorizontalTextAlignment="Center" VerticalTextAlignment="End"/>
            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"  
                   Text="{x:Static strings:AppStrings.FoodName}" 
                HorizontalTextAlignment="Start" Margin="5,0,0,0" VerticalTextAlignment="End"/>

            <Label Grid.Row="1" Grid.Column="2" Text="{x:Static strings:AppStrings.CarbsPer100g}" 
                   HorizontalTextAlignment="Center" VerticalTextAlignment="End"/>
            
            <Entry Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    HorizontalOptions="Fill" VerticalOptions="Fill" 
                    x:Name="txtName" 
                   BackgroundColor="LightGreen" TextColor="Black"
                    ToolTipProperties.Text="{x:Static strings:AppStrings.FoodName}"
                    Keyboard="Text"
                    HorizontalTextAlignment="Start" VerticalTextAlignment="Center"
                    Text="{Binding Name}"
                    FontSize="Small" IsReadOnly="false"
                    TextChanged="txtName_TextChanged"/>
            
            <Entry Grid.Row="2" Grid.Column="2"
                    HorizontalOptions="Fill" VerticalOptions="Fill" 
                    x:Name="txtFoodCarbohydrates" 
                   BackgroundColor="LightGreen" TextColor="Black"
                    ToolTipProperties.Text="{x:Static strings:AppStrings.FoodName}"
                    Keyboard="Text"
                    HorizontalTextAlignment="Start" VerticalTextAlignment="Center"
                    Text="{Binding CarbohydratesPercent.Text}"
                    FontSize="Small" IsReadOnly="false"/>
            
            <Picker Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="1" 
                    x:Name="cmbUnit" Margin="0"
                    HorizontalTextAlignment="Center"
                    SelectedIndexChanged="cmbUnit_SelectedIndexChanged"
                    ToolTipProperties.Text="{x:Static strings:AppStrings.UnitsOfMeasure}"
                    ItemsSource="{Binding}"/>

            <Label Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="1" Margin="5,0,10,0"
                Text="{x:Static strings:AppStrings.Units}" 
                   HorizontalTextAlignment="Center" VerticalTextAlignment="End"/>

            <Label Grid.Row="5" Grid.Column="0" Text="{x:Static strings:AppStrings.CarbsPer100g}" 
                   HorizontalTextAlignment="Center" VerticalTextAlignment="End"/>

            <Button Grid.Row="3" Grid.Column="0"
                            x:Name="btnChoose" 
                            ImageSource="choose.png"
                            BackgroundColor="LightCoral" 
                            TextColor="Black"
                            FontAttributes="Bold"
                            Clicked="btnChoose_Click" />

            <Button Grid.Row="3" Grid.Column="1"
                            x:Name="btnBack" 
                            ImageSource="escape.png"
                            BackgroundColor="LightGreen" 
                            TextColor="White"
                            FontAttributes="Bold"
                            Clicked="btnBack_Click" />
            
            <Button Grid.Row="3" Grid.Column="2" 
                    ImageSource="magnifier.png"
                    x:Name="btnSearchFood" Margin="1"
                ToolTipProperties.Text="{x:Static strings:AppStrings.SearchFood}"
                Clicked="btnSearchFood_Click"/>

            <!-- Fixed header for the results (does not scroll with CollectionView) -->
            <Grid Grid.Row="4" Grid.ColumnSpan="4" BackgroundColor="#e8f5e9" Margin="2" Padding="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="{x:Static strings:AppStrings.Name}" HorizontalTextAlignment="Start" FontAttributes="Bold" TextColor="#2c3e50" />
                <Label Grid.Column="1" Text="{x:Static strings:AppStrings.CHOPercent}" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="#2c3e50" />
            </Grid>

            <CollectionView Grid.Row="5" Grid.ColumnSpan="4"  x:Name="gridFoods" 
                            ToolTipProperties.Text="{x:Static strings:AppStrings.FoodList}"
                            SelectionMode="Single"
                            SelectionChanged="OnGridSelectionAsync"
                            BackgroundColor="LightGray"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="6" Padding="6" Margin="2,1" BackgroundColor="White" BorderColor="{Binding RowBorderColor}" HasShadow="False" HorizontalOptions="FillAndExpand">
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame" Binding="{Binding IsSelectedInList}" Value="True">
                                        <Setter Property="BorderColor" Value="{StaticResource SelectedRowBorderColor}" />
                                        <Setter Property="BackgroundColor" Value="{StaticResource SelectedRowBackgroundColor}" />
                                    </DataTrigger>
                                </Frame.Triggers>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1" />
                                </Frame.GestureRecognizers>
                                <Grid VerticalOptions="Center" ColumnDefinitions="*,50" Padding="2">
                                    <Label Grid.Column="0" Margin="2" HorizontalTextAlignment="Start" TextColor="Black" FontSize="14" Text="{Binding Name}" />
                                    <Label Grid.Column="1" Margin="2" HorizontalTextAlignment="Center" TextColor="Black" FontSize="14" Text="{Binding CarbohydratesPercent.Text}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>